# Copy to .env next to b2_dedup.py. The app loads .env automatically;
# variables already set in the environment win.

# Backblaze B2 credentials (required for upload / restore / verify)
# Create an application key at https://secure.backblaze.com/app_keys.htm
B2_KEY_ID=your_key_id_here
B2_APPLICATION_KEY=your_application_key_here

# Catalog and config live in ./data next to the script. Override only if needed.
# B2_DEDUP_DATA_DIR=/path/to/data

# Optional shared password for the StorageInsights web UI (empty = open on the LAN)
# VAULT_PASSWORD=

# Optional session signing key (a random value is generated per process if unset)
# VAULT_SESSION_SECRET=
